<?xml version="1.0" encoding="utf-8"?>
<graph xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <states>
    <state id="LEVEL" isLevel="true" restartable="true" next="QUIT_GAME">
      <children>
        <child id="SUCCESS" />
        <child id="FAILURE" />
      </children>
    </state>
    <state id="SUCCESS" scene="Success">
      <children>
        <child id="GAME_END" />
      </children>
    </state>
    <state id="FAILURE" scene="Failure">
      <children>
        <child id="GAME_OVER" />
      </children>
    </state>
    <state id="GAME_END" scene="GameEnd" next="QUIT_GAME" />
    <state id="CONTINUE" scene="Continue">
      <children>
        <child id="QUIT_GAME" />
      </children>
    </state>
    <state id="GAME_OVER" scene="GameOver" next="CONTINUE">
      <children>
        <child id="QUIT_GAME" />
      </children>
    </state>
    <state id="QUIT_GAME" scene="QuitGame" />
  </states>
</graph>